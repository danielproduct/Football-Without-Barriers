# The free static demo works with none of these values set.
PORT=3000
# Example base URL: https://YOUR_RESOURCE.openai.azure.com/openai/v1
FOUNDRY_BASE_URL=
FOUNDRY_MODEL=
FOUNDRY_API_KEY=
# Example speech region: uksouth; check supported regions before provisioning.
AZURE_SPEECH_REGION=
AZURE_SPEECH_KEY=
AZURE_SPEECH_VOICE=en-GB-SoniaNeural
